(footprint "USB_Adapter_Pi"
	(version 20240108)
	(generator "pcbnew")
	(layer "F.Cu")
	(descr "A Pi USB adapter (../usb-adapter) as a 3D model in place: board-only, no pads. It stands upright behind the main board at one of the Pi's USB stacks, its plugs in the ports. Origin on the stack's centre line, at the adapter's plug face (its F side), which stands 3 mm off the Pi's port faces, the 15 mm plugs 12 mm in. Model: 3d/USB_adapter.step from tools/export_usb_adapter_step.sh, turned to stand (90, 0, 270), from 1.6 below the main board's front (its back).")
	(tags "Pi USB adapter")
	(property "Reference" "REF**"
		(at 3 -10 90)
		(layer "B.Fab")
		(uuid "6dd2c2ec-61e7-5fd5-895e-6abce57b76b3")
		(effects (font (size 1 1) (thickness 0.15)) (justify mirror))
	)
	(property "Value" "USB adapter"
