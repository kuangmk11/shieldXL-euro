(footprint "Hole_3.2mm"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Panel mounting hole, 3.2 mm non-plated. Origin at the hole centre. Previously supplied by an out-of-tree 'Panel' library; vendored here so the panel project opens on any machine. Pad layers are *.Cu plus 'Rescue', matching the placed instances byte-for-byte. 'Rescue' is a stale layer name inherited from the original out-of-tree Panel library and is NOT in the panel's layer table, so KiCad ignores it and the hole gets no mask aperture. Do not 'correct' it to *.Mask: that would open soldermask around every hole, changing the already-fabbed gerbers, and would raise 27 lib_footprint_mismatch DRC errors.")
