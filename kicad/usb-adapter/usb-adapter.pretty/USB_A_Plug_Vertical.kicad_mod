(footprint "USB_A_Plug_Vertical"
	(version 20240108)
	(generator "make_usb_adapter.py")
	(layer "F.Cu")
	(descr "USB-A male plug, side-mount USB-71 type (L 15 mm, Molex 48037 pattern) stood on its back end: tails straight through in slots, shell tabs in slots at the jack edges")
	(attr through_hole)
	(property "Reference" "REF**" (at 0 -4.5 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "USB_A_Plug_Vertical" (at 0 4.0 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
	(fp_rect (start -6 -2.25) (end 6 2.25) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_line (start -4.5 -1.65) (end 4.5 -1.65) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_text user "insert" (at 0 -0.85 0) (layer "F.Fab") (effects (font (size 0.6 0.6) (thickness 0.08))))
	(fp_rect (start -7.0 -3) (end 7.0 3) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(pad "1" thru_hole rect (at -3.5 0) (size 1.5 1.2) (drill oval 1 0.6) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole oval (at -1 0) (size 1.5 1.2) (drill oval 1 0.6) (layers "*.Cu" "*.Mask"))
	(pad "3" thru_hole oval (at 1 0) (size 1.5 1.2) (drill oval 1 0.6) (layers "*.Cu" "*.Mask"))
	(pad "4" thru_hole oval (at 3.5 0) (size 1.5 1.2) (drill oval 1 0.6) (layers "*.Cu" "*.Mask"))
	(pad "SH" thru_hole oval (at -5.85 0) (size 1.5 4.6) (drill oval 0.9 4) (layers "*.Cu" "*.Mask"))
	(pad "SH" thru_hole oval (at 5.85 0) (size 1.5 4.6) (drill oval 0.9 4) (layers "*.Cu" "*.Mask"))
	(model "${KIPRJMOD}/3d/USB_A_plug_placeholder.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
